# All optional. Copy to .env to override.
# The logbook size limit is read from backend/.env (MAX_LOGBOOK_BYTES), so set it there once.

# Backend base URL the form posts to. Leave unset in dev: Vite then proxies /upload to the backend.
# VITE_API_URL=http://localhost:3000

# Where the dev proxy sends /upload (default http://localhost:3000). Set it if you change the backend PORT.
# DEV_BACKEND_URL=http://localhost:3000
