# All optional. Copy to .env to override.

# Backend base URL the form posts to. Leave unset in dev: Vite then proxies /upload to the backend.
# VITE_API_URL=http://localhost:3000

# Where the dev proxy sends /upload (default http://localhost:3000).
# DEV_BACKEND_URL=http://localhost:3000

# Logbook size limit in bytes (default 1 MB). Keep equal to the backend's MAX_LOGBOOK_BYTES.
# VITE_MAX_LOGBOOK_BYTES=1048576
