{
  "name": "vehicle-selection-challenge",
  "private": true,
  "workspaces": [
    "shared",
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev": "concurrently -n backend,frontend -c blue,green \"npm run dev -w @vehicle/backend\" \"npm run dev -w @vehicle/frontend\"",
    "build": "npm run build -w @vehicle/frontend",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "start": "npm run start -w @vehicle/backend",
    "test": "npm run test --workspaces --if-present",
    "lint": "eslint ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "concurrently": "^9.1.2",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.14.0",
    "typescript-eslint": "^8.72.1"
  }
}
